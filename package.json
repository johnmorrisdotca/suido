{
  "name": "@johnmorrisdotca/suido",
  "version": "1.0.0",
  "description": "Suido, a pipe puzzle for JavaScript and TypeScript: turn the pieces until the water from the pump reaches every drain, with no pipe left open. Boards as short codes, a solver that counts answers, a seeded generator whose every board has exactly one, a difficulty from 1 to 100 within each size, wrap-around edges, several pumps, spare pieces, and the water drawn as SVG that flows as the pipes join. Zero dependencies.",
  "keywords": [
    "puzzle",
    "pipe-puzzle",
    "pipes",
    "net",
    "netwalk",
    "plumbing",
    "water",
    "logic-puzzle",
    "puzzle-generator",
    "puzzle-solver",
    "svg",
    "seeded-random",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://github.com/johnmorrisdotca/suido#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/suido.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/suido/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "test:demo": "pnpm site && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "pictures": "pnpm site && node e2e/shots.mjs docs readme"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
